{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "yair-kanevsky-forge",
	"compatibility_date": "2026-09-04",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, required for ISR/on-demand revalidation.
			// See https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "yair-kanevsky-forge"
		}
	],
	// Without this, whatever logging you enable by hand in the dashboard gets
	// silently reset to disabled on the next deploy — wrangler.jsonc is the
	// source of truth on every push, so it has to declare this explicitly.
	// Discovered 2026-09-07 while trying to get real error logs for the
	// staging Worker: enabling "Logs" in the dashboard kept showing zero
	// events after every redeploy, because it was never actually persisted.
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		}
	},
	// De-minified stack traces in Observability/Logs — without this, a crash
	// log shows unreadable minified positions (worker.js:180732:52, function
	// names like `i9`/`aw`/`tH`) instead of real file/line locations. Added
	// 2026-09-07 while investigating the staging "Internal Server Error".
	"upload_source_maps": true,
	// WHERE THE WORKER RUNS (2026-11). By default a Worker runs in the
	// Cloudflare location nearest to the VISITOR (Israel), while the database
	// (Supabase) is in AWS ap-southeast-2 (Sydney) — so every one of a page's
	// queries crosses half the world and back, one after the other. A
	// placement hint runs the Worker next to the database instead: the
	// visitor's request makes the long trip once, and the queries become
	// short hops. Static files are still served from the nearest location.
	//
	// The automatic "Smart Placement" ({ "mode": "smart" }) is NOT the right
	// tool here: per Cloudflare's docs it needs steady traffic from several
	// locations and can't move a Worker to a place that doesn't normally
	// receive traffic — a small Israeli site never has visitors near Sydney.
	// The explicit form — "placement": { "region": "aws:ap-southeast-2" } —
	// has no such requirement.
	//
	// Rolled out in two steps on purpose. Step 1 (now): only the staging
	// Worker has it (env.staging below). Step 2, once staging has been felt
	// and its `cf-placement` response header shows a Sydney-area location:
	// add the same line right here, so production gets it too. (`placement`
	// IS inherited by named environments, unlike `assets`/`services`.)
	// If the Supabase project ever moves to another region, change/remove it.
	// `production` is this same, unnamed default environment (no --env flag) —
	// the real, in-use site. `staging` is a second, separate Worker that
	// every push deploys to automatically (.github/workflows/deploy.yml) so
	// changes are visible somewhere without touching production; promoting
	// to production is a manual, explicit step
	// (.github/workflows/deploy-production.yml).
	"env": {
		"staging": {
			"name": "yair-kanevsky-forge-staging",
			// Named environments in wrangler.jsonc do NOT automatically inherit
			// top-level `assets`/`services` — each key must be repeated per
			// environment explicitly, or it's silently absent for that Worker.
			// `assets` was missing here (only `services` had been duplicated),
			// which meant the staging Worker had no ASSETS binding at all and
			// crashed on every single request, static or dynamic — discovered
			// 2026-09-07 after this staging environment appeared to never have
			// worked since it was first split off from production.
			"assets": {
				"directory": ".open-next/assets",
				"binding": "ASSETS"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "yair-kanevsky-forge-staging"
				}
			],
			"observability": {
				"logs": {
					"enabled": true,
					"head_sampling_rate": 1,
					"invocation_logs": true
				}
			},
			"upload_source_maps": true,
			// Run next to the database — see "WHERE THE WORKER RUNS" above.
			// To check it took effect: open the staging site, look at any page
			// request's response headers for `cf-placement` (`remote-SYD` or a
			// nearby code = moved; `local-…` = not).
			"placement": { "region": "aws:ap-southeast-2" },
			// Timing of every request to Supabase in the Worker's log
			// (src/lib/supabase/server.ts → timedFetch): set to "1", push,
			// read the lines starting with [perf] under Workers → Logs, and
			// set back to "0". Logs only method, path, status and duration.
			"vars": { "PERF_LOG": "0" }
		}
	}
	// Not yet configured (add when needed):
	// - r2_buckets: persistent ISR/data cache across deploys (create the bucket first)
	// - images: Cloudflare Images binding for next/image optimization
	// See https://opennext.js.org/cloudflare for both.
}
