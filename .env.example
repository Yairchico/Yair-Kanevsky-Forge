# Copy to .env.local for local dev. Get these from the Supabase project
# dashboard: Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used for admin actions (e.g. creating trainee accounts).
# NEVER expose this to the browser / prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
